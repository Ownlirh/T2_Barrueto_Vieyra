# ============================================================
# .gitignore - T2_Barrueto_Vieyra
# Se versiona unicamente el codigo fuente y los archivos de
# configuracion del proyecto. Todo lo que Eclipse o Maven
# puedan volver a generar queda fuera del repositorio.
# ============================================================

# ---------- Compilacion / build de Maven ----------
target/
*.jar
*.war
*.ear
*.class

# ---------- Metadatos de Eclipse ----------
.settings/
.classpath
.project
bin/
.metadata/
*.launch
.apt_generated/
.factorypath

# ---------- Otros IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
nbproject/private/

# ---------- Archivos propios de Maven ----------
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
buildNumber.properties

# ---------- Logs y temporales ----------
*.log
*.tmp
*.bak
*~

# ---------- Credenciales / configuracion local ----------
*.properties.local
application-local.properties
.env

# ---------- Sistema operativo ----------
Thumbs.db
Desktop.ini
.DS_Store
